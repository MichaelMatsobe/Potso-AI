# =============================================================================
# PRODUCTION template — copy to .env.local on the server (never commit secrets)
# =============================================================================
NODE_ENV=production
API_PORT=8080

# --- AI (free / open source) ---
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=llama3.2

# --- Access control (REQUIRED in production) ---
API_ACCESS_KEY=REPLACE_WITH_LONG_RANDOM_STRING
VITE_API_ACCESS_KEY=REPLACE_WITH_SAME_STRING_AS_API_ACCESS_KEY
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# --- CORS: set your real public origin(s), not * ---
ALLOWED_ORIGINS=https://REPLACE_YOUR_DOMAIN
APP_URL=https://REPLACE_YOUR_DOMAIN
VITE_API_URL=https://REPLACE_YOUR_DOMAIN/api

# --- Retention ---
RETENTION_CHAT_DAYS=180
RETENTION_MESSAGE_DAYS=180
RETENTION_DSAR_EXPORT_DAYS=30
RETENTION_DSAR_TICKET_DAYS=730
RETENTION_AUTO_PURGE=true
RETENTION_PURGE_INTERVAL_HOURS=24

# --- Optional local voice ---
# VOICE_STT_URL=http://127.0.0.1:8178/inference
# VOICE_TTS_URL=http://127.0.0.1:5001/tts

# --- Optional Firebase (accounts / synced chats) ---
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_DATABASE_URL=
# FIREBASE_API_KEY=
