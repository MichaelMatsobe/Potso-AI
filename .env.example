# =============================================================================
# Open-source / free AI only — no Gemini, no paid APIs
# =============================================================================
# ollama (default) | freebuff
AI_PROVIDER="ollama"

# --- Ollama (recommended: self-hosted, no quotas) ---
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
OLLAMA_MODEL="llama3.2"
# OLLAMA_FALLBACK_MODELS="qwen2.5,mistral,phi3"

# --- Freebuff (optional free hosted proxy) ---
# AI_PROVIDER="freebuff"
# FREEBUFF_BASE_URL="http://127.0.0.1:8000/v1"
# FREEBUFF_API_KEY="freebuff"
# FREEBUFF_MODEL="deepseek/deepseek-v4-pro"

# Frontend API base
VITE_API_URL="http://localhost:8080/api"

# Optional Firebase (auth/sync only — not required for AI)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_DATABASE_URL=
# FIREBASE_API_KEY=
# VITE_GOOGLE_CLIENT_ID=

APP_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080"
NODE_ENV="development"
API_PORT="8080"
