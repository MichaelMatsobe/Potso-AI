# =============================================================================
# Open-source / free AI only — no paid APIs
# =============================================================================
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
OLLAMA_MODEL="llama3.2"

# Optional Freebuff
# AI_PROVIDER="freebuff"
# FREEBUFF_BASE_URL="http://127.0.0.1:8000/v1"
# FREEBUFF_API_KEY="freebuff"
# FREEBUFF_MODEL="deepseek/deepseek-v4-pro"

# Optional local voice
# VOICE_STT_URL="http://127.0.0.1:8178/inference"
# VOICE_TTS_URL="http://127.0.0.1:5001/tts"

# Access control
# API_ACCESS_KEY="change-me-to-a-long-random-string"
RATE_LIMIT_MAX="60"
RATE_LIMIT_WINDOW_MS="60000"

# Firestore retention (days) — requires GCP TTL policy on field expireAt
RETENTION_CHAT_DAYS="180"
RETENTION_MESSAGE_DAYS="180"
RETENTION_DSAR_EXPORT_DAYS="30"

VITE_API_URL="http://localhost:8080/api"
# VITE_API_ACCESS_KEY="change-me-to-a-long-random-string"

ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080"
APP_URL="http://localhost:3000"
NODE_ENV="development"
API_PORT="8080"

# Optional Firebase
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_DATABASE_URL=
