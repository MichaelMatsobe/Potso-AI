# =============================================================================
# Complementary AI: Ollama (local) + optional Freebuff (hosted free)
# Default AI_PROVIDER=auto → Ollama first, Freebuff if Ollama fails
# =============================================================================
AI_PROVIDER="auto"

# --- Ollama (primary, private, no quota) ---
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
OLLAMA_MODEL="llama3.2"
# OLLAMA_FALLBACK_MODELS="mistral,phi3"

# --- Freebuff (optional complement — enable for hybrid failover) ---
# FREEBUFF_BASE_URL="http://127.0.0.1:8000/v1"
# FREEBUFF_API_KEY="freebuff"
# FREEBUFF_MODEL="deepseek/deepseek-v4-pro"
# FREEBUFF_FALLBACK_MODELS="deepseek/deepseek-v4-flash"

# Force one backend only:
# AI_PROVIDER="ollama"
# AI_PROVIDER="freebuff"

# --- WebLLM (browser WebGPU fallback when API offline) ---
VITE_WEBLLM_ENABLED="true"
# VITE_WEBLLM_MODEL="Llama-3.2-3B-Instruct-q4f16_1-MLC"

# Optional local voice
# VOICE_STT_URL="http://127.0.0.1:8178/inference"
# VOICE_TTS_URL="http://127.0.0.1:5001/tts"

# API_ACCESS_KEY="change-me"
RATE_LIMIT_MAX="60"
RATE_LIMIT_WINDOW_MS="60000"

RETENTION_CHAT_DAYS="180"
RETENTION_MESSAGE_DAYS="180"
RETENTION_DSAR_EXPORT_DAYS="30"
RETENTION_DSAR_TICKET_DAYS="730"
RETENTION_AUTO_PURGE="true"

VITE_API_URL="http://localhost:8080/api"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080"
APP_URL="http://localhost:3000"
NODE_ENV="development"
API_PORT="8080"

# --- Optional Firebase (auth + chat history) ---
# FIREBASE_API_KEY=""
# FIREBASE_PROJECT_ID=""
# GOOGLE_APPLICATION_CREDENTIALS="./serviceAccountKey.json"
