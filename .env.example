# =============================================================================
# AI Provider
# =============================================================================
# gemini  = Google Gemini (requires GEMINI_API_KEY)
# freebuff = Freebuff via OpenAI-compatible proxy (recommended on this branch)
AI_PROVIDER="freebuff"

# --- Freebuff / OpenAI-compatible proxy ---
# Point at a local Freebuff proxy (freebuff2api, Freebuff2API, freebuff-gateway, etc.)
FREEBUFF_BASE_URL="http://127.0.0.1:8000/v1"
# Optional; many local proxies accept any bearer token
FREEBUFF_API_KEY="freebuff"
# Model id exposed by the proxy (examples below)
FREEBUFF_MODEL="deepseek/deepseek-v4-pro"
# FREEBUFF_MODEL="deepseek/deepseek-v4-flash"
# FREEBUFF_MODEL="minimax/minimax-m2.7"

# --- Gemini (optional, when AI_PROVIDER=gemini) ---
GEMINI_API_KEY="your-gemini-api-key-here"
# GEMINI_MODEL="gemini-3-flash-preview"
# GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"

# =============================================================================
# Google OAuth
# =============================================================================
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# =============================================================================
# Firebase Configuration (Get from Firebase Console)
# =============================================================================
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="your-firebase-client-email@iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="your-firebase-private-key-with-escaped-newlines"
FIREBASE_DATABASE_URL="https://your-project.firebaseio.com"
FIREBASE_API_KEY="your-firebase-web-api-key"

# =============================================================================
# Application URLs
# =============================================================================
APP_URL="http://localhost:3000"
API_URL="http://localhost:8080/api"
VITE_API_URL="http://localhost:8080/api"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:8080"

# =============================================================================
# Server Configuration
# =============================================================================
NODE_ENV="development"
API_PORT="8080"
