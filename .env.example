# =============================================================================
# AI Provider — open source + no quotas by default
# =============================================================================
# ollama (default) = self-hosted open weights, unlimited
# freebuff         = optional hosted free models (may have regional limits)
# gemini           = optional paid/key path
AI_PROVIDER="ollama"

# --- Ollama / local OpenAI-compatible (RECOMMENDED) ---
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
OLLAMA_MODEL="llama3.2"
# OLLAMA_FALLBACK_MODELS="qwen2.5,mistral,phi3"
# OLLAMA_API_KEY="ollama"

# Install: https://ollama.com
#   ollama pull llama3.2
#   ollama serve
#
# Other open-weight options:
#   ollama pull qwen2.5
#   ollama pull qwen2.5-coder
#   ollama pull llama3.1
#   ollama pull mistral
#   ollama pull deepseek-r1
#   ollama pull gemma2
#   ollama pull phi3

# --- Freebuff (OPTIONAL — free but not quota-guaranteed) ---
# AI_PROVIDER="freebuff"
# FREEBUFF_BASE_URL="http://127.0.0.1:8000/v1"
# FREEBUFF_API_KEY="freebuff"
# FREEBUFF_MODEL="deepseek/deepseek-v4-pro"

# --- Gemini (OPTIONAL) ---
# AI_PROVIDER="gemini"
# GEMINI_API_KEY="your-gemini-api-key-here"

# =============================================================================
# Google OAuth / Firebase (app auth — independent of AI)
# =============================================================================
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="your-firebase-client-email@iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="your-firebase-private-key-with-escaped-newlines"
FIREBASE_DATABASE_URL="https://your-project.firebaseio.com"
FIREBASE_API_KEY="your-firebase-web-api-key"

APP_URL="http://localhost:3000"
API_URL="http://localhost:8080/api"
VITE_API_URL="http://localhost:8080/api"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:8080"

NODE_ENV="development"
API_PORT="8080"
