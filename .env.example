# =============================================================================
# AI Provider — Freebuff is in charge (no Gemini API key required)
# =============================================================================
# freebuff (default) | ollama | gemini (optional only)
AI_PROVIDER="freebuff"

# --- Freebuff OpenAI-compatible proxy (PRIMARY) ---
# Run Freebuff2API / freebuff2api / freebuff-gateway locally, then:
FREEBUFF_BASE_URL="http://127.0.0.1:8000/v1"
FREEBUFF_API_KEY="freebuff"
FREEBUFF_MODEL="deepseek/deepseek-v4-pro"
# Optional comma-separated failover models (tried after FREEBUFF_MODEL):
# FREEBUFF_FALLBACK_MODELS="deepseek/deepseek-v4-flash,minimax/minimax-m2.7"

# --- Optional local Ollama fallback (true $0 offline) ---
# OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
# OLLAMA_MODEL="llama3.2"

# --- Optional Gemini override (only if AI_PROVIDER=gemini) ---
# GEMINI_API_KEY="your-gemini-api-key-here"
# GEMINI_MODEL="gemini-3-flash-preview"
# GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"

# =============================================================================
# Google OAuth / Firebase (app auth — independent of AI provider)
# =============================================================================
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="your-firebase-client-email@iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="your-firebase-private-key-with-escaped-newlines"
FIREBASE_DATABASE_URL="https://your-project.firebaseio.com"
FIREBASE_API_KEY="your-firebase-web-api-key"

# =============================================================================
# Application URLs
# =============================================================================
APP_URL="http://localhost:3000"
API_URL="http://localhost:8080/api"
VITE_API_URL="http://localhost:8080/api"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:8080"

NODE_ENV="development"
API_PORT="8080"
