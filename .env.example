# =============================================================================
# Open-source / free AI only — no paid APIs
# =============================================================================
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
OLLAMA_MODEL="llama3.2"

# Optional Freebuff
# AI_PROVIDER="freebuff"
# FREEBUFF_BASE_URL="http://127.0.0.1:8000/v1"
# FREEBUFF_API_KEY="freebuff"
# FREEBUFF_MODEL="deepseek/deepseek-v4-pro"

# Optional local voice (whisper.cpp + Piper)
# VOICE_STT_URL="http://127.0.0.1:8178/inference"
# VOICE_TTS_URL="http://127.0.0.1:5001/tts"

# -----------------------------------------------------------------------------
# Access control (recommended for any network-exposed deploy)
# -----------------------------------------------------------------------------
# Require this key on /api/ai, /api/voice, /api/chat:
# API_ACCESS_KEY="change-me-to-a-long-random-string"
# Rate limit (per IP+key window)
RATE_LIMIT_MAX="60"
RATE_LIMIT_WINDOW_MS="60000"
# RATE_LIMIT_DISABLED="true"

VITE_API_URL="http://localhost:8080/api"
# If API_ACCESS_KEY is set, also set the same value for the web client:
# VITE_API_ACCESS_KEY="change-me-to-a-long-random-string"

# CORS — use explicit origins in production, not *
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080"
APP_URL="http://localhost:3000"
NODE_ENV="development"
API_PORT="8080"

# Optional Firebase
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_DATABASE_URL=
